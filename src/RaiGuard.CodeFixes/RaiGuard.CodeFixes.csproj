<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RaiGuard.Core\RaiGuard.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.8.0" PrivateAssets="all" />
  </ItemGroup>

	<!-- Compiler tooling only. The previously released analyzer keeps the release graph acyclic. -->
	<ItemGroup>
		<PackageDownload Include="RaiGuard.Analyzer" Version="[4.6.7]" />
		<Analyzer Include="$(NuGetPackageRoot)/raiguard.analyzer/4.6.7/analyzers/dotnet/cs/RaiGuard.Core.dll" />
	</ItemGroup>

</Project>
